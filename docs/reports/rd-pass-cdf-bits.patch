+// A symbol sink for the syntax templates (bitstream/coeff_syntax.h) that prices instead of codes:
+// each symbol's bits under its CDF as it stands (no adaptation), literals and bits at 1 bit each.
+#pragma once
+#include <cmath>
+#include <cstdint>
+
+#include "av2/common/entropy.h"
+
+namespace celv2 {
+
+struct BitCount {
+  double bits = 0;
+  // avm_od_ec_encode_cdf_q15()'s probability of s under the inverse CDF icdf.
+  void symbol(int s, const avm_cdf_prob* icdf, int n) {
+    (void)n;
+    const int hi = s > 0 ? icdf[s - 1] : CDF_PROB_TOP, p = hi - icdf[s];
+    bits += std::log2(static_cast<double>(CDF_PROB_TOP) / (p > 0 ? p : 1));
+  }
+  void literal(int v, int n) { (void)v, bits += n; }
+  void bit(int b) { (void)b, bits += 1; }
+};
+
+}  // namespace celv2
